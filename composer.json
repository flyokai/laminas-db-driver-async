{
    "name": "flyokai/laminas-db-driver-async",
    "description": "Async driver for laminas db",
    "require": {
        "php": "^8.1",
        "amphp/amp": "^3.0.2",
        "amphp/parallel": "^2.3.1",
        "laminas/laminas-db": "^2.5",
        "flyokai/revolt-event-loop": "^1",
        "ext-pdo": "*"
    },
    "license": [
        "MIT"
    ],
    "autoload": {
        "files": [
            "src/functions.php"
        ],
        "psr-4": {
            "Flyokai\\LaminasDbDriverAsync\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-dev-main": "1.1.x-dev",
            "dev-main": "1.1.x-dev"
        }
    }
}
